# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` for local dev, and add the same keys in
# the Vercel dashboard (Settings → Environment Variables).
# Every one of these is OPTIONAL — the site degrades gracefully
# without them. See README for what changes.
# ─────────────────────────────────────────────────────────────

# GitHub personal access token (classic), scope: read:user
# Without it /api/github falls back to parsing the public contributions
# page, which works but reports only publicly-visible activity.
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# EmailJS — without all three, the contact form falls back to opening
# the visitor's mail client with the message pre-filled.
# Dashboard: https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
